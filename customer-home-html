<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Rwanda House Market</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f7f4f1;
      color: #2f211b;
    }

    /* ================= HEADER ================= */

    header {
      background: #4b2e24;
      color: white;
      padding: 18px 15px;
      text-align: center;
    }

    header h1 {
      margin: 0;
      font-size: 28px;
    }

    /* ================= NAVIGATION ================= */

    .navbar {
      background: #ffffff;
      border-bottom: 2px solid #4b2e24;
      display: flex;
      justify-content: center;
      align-items: center;
      flex-wrap: wrap;
      gap: 5px;
      padding: 8px;
      position: sticky;
      top: 0;
      z-index: 1000;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .navbar a {
      color: #4b2e24;
      text-decoration: none;
      padding: 11px 14px;
      border-radius: 6px;
      font-weight: bold;
      font-size: 14px;
    }

    .navbar a:hover {
      background: #4b2e24;
      color: white;
    }

    .profile-link {
      background: #4b2e24 !important;
      color: white !important;
    }

    /* ================= CONTAINER ================= */

    .container {
      max-width: 1150px;
      margin: auto;
      padding: 30px 20px 100px;
    }

    /* ================= WELCOME ================= */

    .welcome {
      background: white;
      border-radius: 15px;
      padding: 35px 20px;
      text-align: center;
      box-shadow: 0 3px 12px rgba(0,0,0,0.10);
      margin-bottom: 30px;
    }

    .welcome h2 {
      margin-top: 0;
      color: #4b2e24;
      font-size: 30px;
    }

    .welcome p {
      color: #66554d;
      font-size: 17px;
    }

    /* ================= CATEGORIES ================= */

    .categories {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 25px;
    }

    .category {
      background: white;
      border-radius: 15px;
      padding: 30px 20px;
      text-align: center;
      box-shadow: 0 3px 12px rgba(0,0,0,0.10);
      transition: 0.2s;
    }

    .category:hover {
      transform: translateY(-4px);
    }

    .icon {
      font-size: 55px;
      margin-bottom: 12px;
    }

    .category h3 {
      color: #4b2e24;
      font-size: 23px;
      margin: 10px 0;
    }

    .category p {
      color: #66554d;
      line-height: 1.5;
      min-height: 45px;
    }

    .category a {
      display: inline-block;
      background: #4b2e24;
      color: white;
      text-decoration: none;
      padding: 12px 22px;
      border-radius: 8px;
      margin-top: 10px;
      font-weight: bold;
    }

    .category a:hover {
      background: #321e17;
    }

    /* ================= FOOTER ================= */

    footer {
      background: #4b2e24;
      color: white;
      text-align: center;
      padding: 25px 15px;
      margin-top: 30px;
    }

    footer p {
      margin: 8px 0;
    }

    .chat-now {
      display: inline-block;
      background: white;
      color: #4b2e24;
      text-decoration: none;
      padding: 11px 20px;
      border-radius: 8px;
      font-weight: bold;
      margin-top: 8px;
    }

    .chat-now:hover {
      background: #eee;
    }

    .facebook {
      display: inline-block;
      color: white;
      text-decoration: none;
      margin-top: 10px;
      font-weight: bold;
    }

    .facebook:hover {
      text-decoration: underline;
    }

    /* ================= MOBILE ================= */

    @media (max-width: 700px) {

      header h1 {
        font-size: 23px;
      }

      .navbar {
        justify-content: flex-start;
        overflow-x: auto;
        flex-wrap: nowrap;
      }

      .navbar a {
        white-space: nowrap;
        font-size: 13px;
        padding: 10px 12px;
      }

      .welcome h2 {
        font-size: 25px;
      }

      .container {
        padding: 20px 15px 80px;
      }
    }
  </style>
</head>

