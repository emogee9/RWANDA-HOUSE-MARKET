<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>plot detail - Rwanda House Market</title>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

  <style>
    *{
      box-sizing:border-box;
    }

    body{
      margin:0;
      font-family:Arial,sans-serif;
      background:#f5f5f5;
      color:#222;
    }

    header{
      background:#f2c400;
      padding:22px 15px;
      text-align:center;
      box-shadow:0 3px 12px rgba(0,0,0,.15);
    }

    header h1{
      margin:0;
      font-size:28px;
    }

    .back{
      display:inline-block;
      margin-top:12px;
      background:white;
      color:#222;
      text-decoration:none;
      padding:10px 18px;
      border-radius:8px;
      font-weight:bold;
    }

    .container{
      max-width:1100px;
      margin:auto;
      padding:25px 20px 60px;
    }

    .photo-slider{
      position:relative;
      background:white;
      padding:12px;
      border-radius:15px;
      border:2px solid #f2c400;
      box-shadow:0 3px 12px rgba(0,0,0,.12);
    }

    .photo-slider img{
      width:100%;
      height:520px;
      object-fit:cover;
      border-radius:10px;
      display:block;
    }

    .arrow{
      position:absolute;
      top:50%;
      transform:translateY(-50%);
      width:50px;
      height:50px;
      border:0;
      border-radius:50%;
      background:#f2c400;
      color:#222;
      font-size:30px;
      font-weight:bold;
      cursor:pointer;
      z-index:5;
    }

    .left{
      left:25px;
    }

    .right{
      right:25px;
    }

    .gallery{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:12px;
      margin-top:15px;
    }

    .gallery img{
      width:100%;
      height:110px;
      object-fit:cover;
      border-radius:10px;
      cursor:pointer;
      border:2px solid transparent;
    }

    .gallery img:hover{
      border-color:#f2c400;
    }

    .info{
      background:white;
      margin-top:25px;
      padding:28px;
      border-radius:15px;
      border:2px solid #f2c400;
      box-shadow:0 3px 12px rgba(0,0,0,.12);
    }

    .info h2{
      font-size:30px;
      margin-top:0;
    }

    .type{
      display:inline-block;
      background:#fff8d6;
      color:#8a6500;
      padding:8px 15px;
      border-radius:20px;
      border:1px solid #f2c400;
      font-weight:bold;
    }

    .price{
      font-size:26px;
      color:#b27b00;
      font-weight:bold;
      margin:18px 0;
    }

    .location{
      font-size:17px;
      line-height:1.9;
    }

    .details{
      margin-top:25px;
      line-height:2;
      font-size:17px;
    }

    .description{
      color:#555;
      line-height:1.7;
      white-space:pre-wrap;
    }

    .contact{
      margin-top:25px;
      padding-top:20px;
      border-top:2px solid #f2c400;
    }

    .whatsapp,
    .call{
      display:inline-block;
      margin-top:10px;
      padding:13px 20px;
      border-radius:8px;
      text-decoration:none;
      color:white;
      font-weight:bold;
    }

    .whatsapp{
      background:#128c7e;
    }

    .call{
      background:#f2c400;
      color:#222;
    }

    .loading,
    .error{
      background:white;
      padding:40px;
      text-align:center;
      border-radius:12px;
      box-shadow:0 3px 12px rgba(0,0,0,.10);
    }

    .error{
      border:2px solid #e00000;
      color:#b00000;
    }

    @media(max-width:700px){

      .photo-slider img{
        height:300px;
      }

      .gallery{
        grid-template-columns:repeat(2,1fr);
      }

      .gallery img{
        height:100px;
      }

      .info h2{
        font-size:25px;
      }

      .arrow{
        width:42px;
        height:42px;
        font-size:25px;
      }
    }
  </style>
</head>

<body>

<header>

  <h1 id="headerTitle">
    🏡 RWANDA HOUSE MARKET
  </h1>

  <a
    href="plot.html"
    class="back"
    id="backButton">
    ← Back to Plots
  </a>

</header>

<div class="container">

  <div id="content">

    <div class="loading">
      Loading plot detail...
    </div>

  </div>

</div>

<script>

/* =========================================================
   SUPABASE
========================================================= */

const SUPABASE_URL =
  "https://hsmnybmcddtsyooltozw.supabase.co";

const SUPABASE_KEY =
  "sb_publishable_oHhsRZQcMwIcReU48WE9mw_FdzMO29u";

const supabaseClient =
  window.supabase.createClient(
    SUPABASE_URL,
    SUPABASE_KEY
  );


/* =========================================================
   LANGUAGE
========================================================= */

const language =
  localStorage.getItem("selectedLanguage") || "English";


const translations = {

  Kinyarwanda: {

    back: "← Subira ku bibanza",

    loading: "Turimo gushaka amakuru y'ikibanza...",

    notFound: "Ikibanza nticyabonetse.",

    noId: "ID y'ikibanza ntiyabonetse.",

    type: "Ikibanza kigura",

    country: "Igihugu",

    province: "Intara",

    district: "Akarere",

    sector: "Umurenge",

    details: "Ibisobanuro by'ikibanza",

    bedrooms: "Ibyumba",

    bathrooms: "Ubwiherero",

    parking: "Parking",

    description: "Ibisobanuro",

    contact: "📞 Aho mwadusanga",

    whatsapp: "💬 WhatsApp",

    call: "📞 Hamagara",

    noPhoto: "Nta foto ihari",

    plot: "Ikibanza kigura"

  },


  English: {

    back: "← Back to Plots",

    loading: "Loading plot detail...",

    notFound: "Plot not found.",

    noId: "Plot ID was not found.",

    type: "Plot for Sale",

    country: "Country",

    province: "Province",

    district: "District",

    sector: "Sector",

    details: "Property Details",

    bedrooms: "Bedrooms",

    bathrooms: "Bathrooms",

    parking: "Parking",

    description: "Description",

    contact: "📞 Contact",

    whatsapp: "💬 WhatsApp",

    call: "📞 Call",

    noPhoto: "No photo available",

    plot: "Plot for Sale"

  },


  Français: {

    back: "← Retour aux terrains",

    loading: "Chargement des détails du terrain...",

    notFound: "Terrain introuvable.",

    noId: "ID du terrain introuvable.",

    type: "Terrain à vendre",

    country: "Pays",

    province: "Province",

    district: "District",

    sector: "Secteur",

    details: "Détails du terrain",

    bedrooms: "Chambres",

    bathrooms: "Salles de bain",

    parking: "Parking",

    description: "Description",

    contact: "📞 Contact",

    whatsapp: "💬 WhatsApp",

    call: "📞 Appeler",

    noPhoto: "Aucune photo disponible",

    plot: "Terrain à vendre"

  },


  Kiswahili: {

    back: "← Rudi kwenye Viwanja",

    loading: "Inapakia maelezo ya kiwanja...",

    notFound: "Kiwanja hakikupatikana.",

    noId: "ID ya kiwanja haikupatikana.",

    type: "Kiwanja cha Kuuza",

    country: "Nchi",

    province: "Mkoa",

    district: "Wilaya",

    sector: "Sekta",

    details: "Maelezo ya Kiwanja",

    bedrooms: "Vyumba vya kulala",

    bathrooms: "Vyumba vya bafu",

    parking: "Maegesho",

    description: "Maelezo",

    contact: "📞 Mawasiliano",

    whatsapp: "💬 WhatsApp",

    call: "📞 Piga Simu",

    noPhoto: "Hakuna picha",

    plot: "Kiwanja cha Kuuza"

  },


  "中文": {

    back: "← 返回土地",

    loading: "正在加载土地详情...",

    notFound: "未找到该土地。",

    noId: "未找到土地 ID。",

    type: "出售土地",

    country: "国家",

    province: "省",

    district: "地区",

    sector: "区域",

    details: "土地详情",

    bedrooms: "卧室",

    bathrooms: "浴室",

    parking: "停车位",

    description: "描述",

    contact: "📞 联系方式",

    whatsapp: "💬 WhatsApp",

    call: "📞 致电",

    noPhoto: "暂无照片",

    plot: "出售土地"

  }

};


const t =
  translations[language] ||
  translations.English;


/* =========================================================
   APPLY LANGUAGE
========================================================= */

document.getElementById("backButton").textContent =
  t.back;


/* =========================================================
   ESCAPE HTML
========================================================= */

function escapeHtml(value){

  return String(value ?? "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}


/* =========================================================
   GET ONLY THE CLICKED PROPERTY ID
========================================================= */

const params =
  new URLSearchParams(
    window.location.search
  );


/*
   Accept:

   plot-detail.html?id=123

   or

   plot-detail.html?property_id=123
*/

const propertyId =
  params.get("id") ||
  params.get("property_id");


/* =========================================================
   PHOTOS
========================================================= */

let photos = [];

let currentPhoto = 0;


function showPhoto(index){

  if(!photos.length){
    return;
  }

  currentPhoto = index;

  const mainPhoto =
    document.getElementById("mainPhoto");

  if(mainPhoto){
    mainPhoto.src =
      photos[currentPhoto];
  }

}


function nextPhoto(){

  if(!photos.length){
    return;
  }

  currentPhoto++;

  if(currentPhoto >= photos.length){
    currentPhoto = 0;
  }

  showPhoto(currentPhoto);

}


function previousPhoto(){

  if(!photos.length){
    return;
  }

  currentPhoto--;

  if(currentPhoto < 0){
    currentPhoto =
      photos.length - 1;
  }

  showPhoto(currentPhoto);

}


/* =========================================================
   LOAD ONLY CLICKED PLOT
========================================================= */

async function loadDetail(){

  const content =
    document.getElementById("content");


  /* -------------------------------------------------------
     CHECK ID
  ------------------------------------------------------- */

  if(!propertyId){

    content.innerHTML = `

      <div class="error">

        ❌ ${escapeHtml(t.noId)}

        <br><br>

        <a href="plot.html">
          ${escapeHtml(t.back)}
        </a>

      </div>

    `;

    return;
  }


  /* -------------------------------------------------------
     SHOW LOADING
  ------------------------------------------------------- */

  content.innerHTML = `

    <div class="loading">

      ${escapeHtml(t.loading)}

    </div>

  `;


  /* -------------------------------------------------------
     GET EXACTLY ONE PROPERTY FROM SUPABASE
  ------------------------------------------------------- */

  const {
    data,
    error
  } =
    await supabaseClient

      .from("property_posts")

      .select("*")

      .eq("id", propertyId)

      .maybeSingle();


  /* -------------------------------------------------------
     DATABASE ERROR
  ------------------------------------------------------- */

  if(error){

    console.error(
      "Supabase detail error:",
      error
    );

    content.innerHTML = `

      <div class="error">

        ❌ ${escapeHtml(error.message)}

        <br><br>

        <a href="plot.html">
          ${escapeHtml(t.back)}
        </a>

      </div>

    `;

    return;
  }


  /* -------------------------------------------------------
     PROPERTY NOT FOUND
  ------------------------------------------------------- */

  if(!data){

    content.innerHTML = `

      <div class="error">

        ❌ ${escapeHtml(t.notFound)}

        <br><br>

        <a href="plot.html">
          ${escapeHtml(t.back)}
        </a>

      </div>

    `;

    return;
  }


  /*
     IMPORTANT:

     We DO NOT load all properties.

     We only use the row whose ID
     equals the ID clicked by the user.
  */


  /* =======================================================
     PHOTOS
  ======================================================= */

  photos = [];

  currentPhoto = 0;


  /* Main photo */

  if(data.main_photo){

    photos.push(
      data.main_photo
    );

  }


  /* Other photos */

  if(Array.isArray(data.other_photos)){

    data.other_photos.forEach(
      photo => {

        if(
          photo &&
          !photos.includes(photo)
        ){

          photos.push(photo);

        }

      }
    );

  }


  /* If no photo */

  if(!photos.length){

    photos.push(
      "https://via.placeholder.com/1200x700?text=No+Photo"
    );

  }


  /* =======================================================
     PAGE TITLE
  ======================================================= */

  document.title =
    (data.title || t.plot) +
    " - Rwanda House Market";


  /* =======================================================
     GALLERY
  ======================================================= */

  let galleryHTML = "";


  photos.forEach(
    (photo,index) => {

      galleryHTML += `

        <img
          src="${escapeHtml(photo)}"
          onclick="showPhoto(${index})"
          alt="Plot Photo">

      `;

    }
  );


  /* =======================================================
     DETAIL HTML
  ======================================================= */

  content.innerHTML = `

    <!-- PHOTO SLIDER -->

    <div class="photo-slider">

      <button
        class="arrow left"
        onclick="previousPhoto()">
        ‹
      </button>


      <img
        id="mainPhoto"
        src="${escapeHtml(photos[0])}"
        alt="${escapeHtml(data.title || t.plot)}">


      <button
        class="arrow right"
        onclick="nextPhoto()">
        ›
      </button>

    </div>


    <!-- PHOTO GALLERY -->

    <div class="gallery">

      ${galleryHTML}

    </div>


    <!-- PROPERTY INFORMATION -->

    <div class="info">

      <h2>
        ${escapeHtml(
          data.title || t.plot
        )}
      </h2>


      <div class="type">

        ${escapeHtml(
          data.property_type || t.type
        )}

      </div>


      <div class="price">

        ${Number(
          data.price || 0
        ).toLocaleString()} RWF

      </div>


      <!-- LOCATION -->

      <div class="location">

        ${
          data.country
          ? `
            🌍 <strong>
              ${escapeHtml(t.country)}:
            </strong>
            ${escapeHtml(data.country)}
            <br>
          `
          : ""
        }


        ${
          data.province
          ? `
            📍 <strong>
              ${escapeHtml(t.province)}:
            </strong>
            ${escapeHtml(data.province)}
            <br>
          `
          : ""
        }


        ${
          data.district
          ? `
            📍 <strong>
              ${escapeHtml(t.district)}:
            </strong>
            ${escapeHtml(data.district)}
            <br>
          `
          : ""
        }


        ${
          data.sector
          ? `
            📍 <strong>
              ${escapeHtml(t.sector)}:
            </strong>
            ${escapeHtml(data.sector)}
            <br>
          `
          : ""
        }


        ${
          data.location
          ? `
            📍 <strong>
              Location:
            </strong>
            ${escapeHtml(data.location)}
          `
          : ""
        }

      </div>


      <!-- DETAILS -->

      <h3>
        ${escapeHtml(t.details)}
      </h3>


      <div class="details">

        ${
          data.bedrooms !== null &&
          data.bedrooms !== undefined
          ? `
            🛏️
            ${escapeHtml(t.bedrooms)}:
            ${escapeHtml(data.bedrooms)}
            <br>
          `
          : ""
        }


        ${
          data.bathrooms !== null &&
          data.bathrooms !== undefined
          ? `
            🚿
            ${escapeHtml(t.bathrooms)}:
            ${escapeHtml(data.bathrooms)}
            <br>
          `
          : ""
        }


        ${
          data.parking !== null &&
          data.parking !== undefined
          ? `
            🚗
            ${escapeHtml(t.parking)}:
            ${escapeHtml(data.parking)}
          `
          : ""
        }

      </div>


      <!-- DESCRIPTION -->

      <h3>
        ${escapeHtml(t.description)}
      </h3>


      <p class="description">

        ${escapeHtml(
          data.description || ""
        )}

      </p>


      <!-- CONTACT -->

      <div class="contact">

        <h3>
          ${escapeHtml(t.contact)}
        </h3>


        <p>
          <strong>
            +250 799 645 553
          </strong>
        </p>


        <a
          href="https://wa.me/250799645553"
          target="_blank"
          class="whatsapp">

          ${escapeHtml(t.whatsapp)}

        </a>


        <a
          href="tel:+250799645553"
          class="call">

          ${escapeHtml(t.call)}

        </a>

      </div>

    </div>

  `;

}


/* =========================================================
   START
========================================================= */

loadDetail();

</script>

</body>
</html>
