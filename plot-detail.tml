<script src="language.js"></script>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Plot Details - Rwanda House Market</title>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<style>
*{
  box-sizing:border-box;
}

body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#f5f5f5;
  color:#222;
}

header{
  background:#f2c400;
  padding:22px 15px;
  text-align:center;
  box-shadow:0 3px 12px rgba(0,0,0,.15);
}

header h1{
  margin:0;
  font-size:28px;
}

.back{
  display:inline-block;
  margin-top:10px;
  background:white;
  color:#222;
  text-decoration:none;
  padding:10px 16px;
  border-radius:8px;
  font-weight:bold;
}

.container{
  max-width:1100px;
  margin:auto;
  padding:25px 20px 60px;
}

.photo-slider{
  position:relative;
  background:white;
  padding:12px;
  border-radius:15px;
  border:2px solid #f2c400;
  box-shadow:0 3px 12px rgba(0,0,0,.12);
}

.photo-slider img{
  width:100%;
  height:520px;
  object-fit:cover;
  border-radius:10px;
  display:block;
}

.arrow{
  position:absolute;
  top:50%;
  transform:translateY(-50%);
  width:50px;
  height:50px;
  border:0;
  border-radius:50%;
  background:#f2c400;
  color:#222;
  font-size:30px;
  font-weight:bold;
  cursor:pointer;
  z-index:5;
}

.left{
  left:25px;
}

.right{
  right:25px;
}

.gallery{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:12px;
  margin-top:15px;
}

.gallery img{
  width:100%;
  height:110px;
  object-fit:cover;
  border-radius:10px;
  cursor:pointer;
  border:2px solid transparent;
}

.gallery img:hover{
  border-color:#f2c400;
}

.info{
  background:white;
  margin-top:25px;
  padding:28px;
  border-radius:15px;
  border:2px solid #f2c400;
  box-shadow:0 3px 12px rgba(0,0,0,.12);
}

.info h2{
  font-size:30px;
  margin-top:0;
}

.type{
  display:inline-block;
  background:#fff8d6;
  color:#8a6500;
  padding:8px 15px;
  border-radius:20px;
  border:1px solid #f2c400;
  font-weight:bold;
}

.price{
  font-size:26px;
  color:#b27b00;
  font-weight:bold;
  margin:18px 0;
}

.location{
  font-size:17px;
  line-height:1.8;
}

.details{
  margin-top:25px;
  line-height:2;
  font-size:17px;
}

.description{
  color:#555;
  line-height:1.7;
}

.contact{
  margin-top:25px;
  padding-top:20px;
  border-top:2px solid #f2c400;
}

.whatsapp,
.call{
  display:inline-block;
  margin-top:10px;
  padding:13px 20px;
  border-radius:8px;
  text-decoration:none;
  color:white;
  font-weight:bold;
}

.whatsapp{
  background:#128c7e;
}

.call{
  background:#f2c400;
  color:#222;
}

.loading,
.error{
  background:white;
  padding:40px;
  text-align:center;
  border-radius:12px;
}

@media(max-width:700px){

  .photo-slider img{
    height:300px;
  }

  .gallery{
    grid-template-columns:repeat(2,1fr);
  }

  .gallery img{
    height:100px;
  }

  .info h2{
    font-size:25px;
  }

}
</style>
</head>

<body>

<header>

  <h1 id="headerTitle">
    🏡 RWANDA HOUSE MARKET
  </h1>

  <a
    href="./plot.html"
    class="back"
    id="backButton">
    ← Back to Plots
  </a>

</header>


<div class="container">

  <div id="content">

    <div class="loading">
      Loading plot details...
    </div>

  </div>

</div>


<script>

/* ===============================
   SUPABASE
================================ */

const SUPABASE_URL =
  "https://hsmnybmcddtsyooltozw.supabase.co";

const SUPABASE_KEY =
  "sb_publishable_oHhsRZQcMwIcReU48WE9mw_FdzMO29u";

const supabaseClient =
  window.supabase.createClient(
    SUPABASE_URL,
    SUPABASE_KEY
  );


/* ===============================
   LANGUAGE
================================ */

const language =
  localStorage.getItem(
    "selectedLanguage"
  ) || "English";


const translations = {

  Kinyarwanda:{

    back:
      "← Subira ku bibanza",

    type:
      "Ikibanza kigura",

    country:
      "Igihugu",

    province:
      "Intara",

    district:
      "Akarere",

    sector:
      "Umurenge",

    details:
      "Ibisobanuro by'ikibanza",

    bedrooms:
      "Ibyumba",

    bathrooms:
      "Ubwiherero",

    parking:
      "Parking",

    description:
      "Ibisobanuro",

    contact:
      "📞 Aho mwadusanga",

    whatsapp:
      "💬 WhatsApp",

    call:
      "📞 Hamagara"

  },

  English:{

    back:
      "← Back to Plots",

    type:
      "Plot for Sale",

    country:
      "Country",

    province:
      "Province",

    district:
      "District",

    sector:
      "Sector",

    details:
      "Property Details",

    bedrooms:
      "Bedrooms",

    bathrooms:
      "Bathrooms",

    parking:
      "Parking",

    description:
      "Description",

    contact:
      "📞 Contact",

    whatsapp:
      "💬 WhatsApp",

    call:
      "📞 Call"

  },

  Français:{

    back:
      "← Retour aux terrains",

    type:
      "Terrain à vendre",

    country:
      "Pays",

    province:
      "Province",

    district:
      "District",

    sector:
      "Secteur",

    details:
      "Détails du terrain",

    bedrooms:
      "Chambres",

    bathrooms:
      "Salles de bain",

    parking:
      "Parking",

    description:
      "Description",

    contact:
      "📞 Contact",

    whatsapp:
      "💬 WhatsApp",

    call:
      "📞 Appeler"

  },

  Kiswahili:{

    back:
      "← Rudi kwenye Viwanja",

    type:
      "Kiwanja cha Kuuza",

    country:
      "Nchi",

    province:
      "Mkoa",

    district:
      "Wilaya",

    sector:
      "Sekta",

    details:
      "Maelezo ya Kiwanja",

    bedrooms:
      "Vyumba vya kulala",

    bathrooms:
      "Vyumba vya bafu",

    parking:
      "Maegesho",

    description:
      "Maelezo",

    contact:
      "📞 Mawasiliano",

    whatsapp:
      "💬 WhatsApp",

    call:
      "📞 Piga Simu"

  },

  "中文":{

    back:
      "← 返回土地",

    type:
      "出售土地",

    country:
      "国家",

    province:
      "省",

    district:
      "地区",

    sector:
      "区域",

    details:
      "土地详情",

    bedrooms:
      "卧室",

    bathrooms:
      "浴室",

    parking:
      "停车位",

    description:
      "描述",

    contact:
      "📞 联系方式",

    whatsapp:
      "💬 WhatsApp",

    call:
      "📞 致电"

  }

};


const t =
  translations[language] ||
  translations.English;


document.getElementById(
  "backButton"
).textContent = t.back;


/* ===============================
   ESCAPE
================================ */

function escapeHtml(value){

  return String(value ?? "")
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");

}


/* ===============================
   GET PROPERTY ID
================================ */

const params =
  new URLSearchParams(
    window.location.search
  );

const propertyId =
  params.get("id");


/* ===============================
   PHOTOS
================================ */

let photos = [];

let currentPhoto = 0;


function showPhoto(index){

  if(!photos.length){
    return;
  }

  currentPhoto = index;

  document.getElementById(
    "mainPhoto"
  ).src = photos[currentPhoto];

}


function nextPhoto(){

  if(!photos.length){
    return;
  }

  currentPhoto++;

  if(
    currentPhoto >= photos.length
  ){
    currentPhoto = 0;
  }

  showPhoto(currentPhoto);

}


function previousPhoto(){

  if(!photos.length){
    return;
  }

  currentPhoto--;

  if(currentPhoto < 0){
    currentPhoto =
      photos.length - 1;
  }

  showPhoto(currentPhoto);

}


/* ===============================
   LOAD DETAIL
================================ */

async function loadDetail(){

  const content =
    document.getElementById("content");


  if(!propertyId){

    content.innerHTML = `
      <div class="error">
        ❌ Property ID ntiyabonetse.
      </div>
    `;

    return;
  }


  const {
    data,
    error
  } =
  await supabaseClient
    .from("property_posts")
    .select("*")
    .eq("id",propertyId)
    .eq("property_type","plot")
    .maybeSingle();


  if(error){

    console.error(error);

    content.innerHTML = `
      <div class="error">
        ❌ ${escapeHtml(error.message)}
      </div>
    `;

    return;
  }


  if(!data){

    content.innerHTML = `
      <div class="error">
        ❌ Plot ntiyabonetse.
      </div>
    `;

    return;
  }


  /* MAIN PHOTO */

  if(data.main_photo){

    photos.push(
      data.main_photo
    );

  }


  /* OTHER PHOTOS */

  if(
    Array.isArray(
      data.other_photos
    )
  ){

    data.other_photos.forEach(
      photo => {

        if(
          photo &&
          !photos.includes(photo)
        ){

          photos.push(photo);

        }

      }
    );

  }


  if(!photos.length){

    photos.push(
      "https://via.placeholder.com/1200x700?text=No+Photo"
    );

  }


  document.title =
    (data.title || "Plot") +
    " - Rwanda House Market";


  let galleryHTML = "";


  photos.forEach(
    (photo,index) => {

      galleryHTML += `

        <img
          src="${escapeHtml(photo)}"
          onclick="showPhoto(${index})"
          alt="Plot Photo">

      `;

    }
  );


  content.innerHTML = `

    <div class="photo-slider">

      <button
        class="arrow left"
        onclick="previousPhoto()">
        ‹
      </button>

      <img
        id="mainPhoto"
        src="${escapeHtml(photos[0])}"
        alt="Plot">

      <button
        class="arrow right"
        onclick="nextPhoto()">
        ›
      </button>

    </div>


    <div class="gallery">

      ${galleryHTML}

    </div>


    <div class="info">

      <h2>
        ${escapeHtml(
          data.title || "Plot for Sale"
        )}
      </h2>


      <div class="type">
        ${t.type}
      </div>


      <div class="price">

        ${Number(
          data.price || 0
        ).toLocaleString()} RWF

      </div>


      <div class="location">

        🌍 <strong>${t.country}:</strong>
        ${escapeHtml(data.country || "")}

        <br>

        📍 <strong>${t.province}:</strong>
        ${escapeHtml(data.province || "")}

        <br>

        📍 <strong>${t.district}:</strong>
        ${escapeHtml(data.district || "")}

        <br>

        📍 <strong>${t.sector}:</strong>
        ${escapeHtml(data.sector || "")}

      </div>


      <h3>
        ${t.details}
      </h3>


      <div class="details">

        🛏️ ${t.bedrooms}:
        ${data.bedrooms ?? 0}

        <br>

        🚿 ${t.bathrooms}:
        ${data.bathrooms ?? 0}

        <br>

        🚗 ${t.parking}:
        ${data.parking ?? 0}

      </div>


      <h3>
        ${t.description}
      </h3>


      <p class="description">

        ${escapeHtml(
          data.description ||
          ""
        )}

      </p>


      <div class="contact">

        <h3>
          ${t.contact}
        </h3>

        <p>
          <strong>
            +250 799 645 553
          </strong>
        </p>


        <a
          href="https://wa.me/250799645553"
          target="_blank"
          class="whatsapp">

          ${t.whatsapp}

        </a>


        <a
          href="tel:+250799645553"
          class="call">

          ${t.call}

        </a>

      </div>

    </div>

  `;

}


loadDetail();

</script>

</body>
</html>
